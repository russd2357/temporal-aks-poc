{
  "name": "temporal-demo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "rimraf ./dist && tsc --build",
    "build.watch": "tsc --build --watch",
    "lint": "eslint .",
    "start": "ts-node src/worker.ts",
    "start.watch": "ts-node-dev src/worker.ts",
    "workflow": "ts-node src/client.ts",
    "onboard": "ts-node src/onboard-client.ts",
    "start.onworker-dev": "ts-node-dev src/onbworker.ts",
    "start.onworker": "npm run build && node dist/onbworker.js"
  },
  "nodemonConfig": {
    "execMap": {
      "ts": "ts-node"
    },
    "ext": "ts",
    "watch": [
      "src"
    ]
  },
  "dependencies": {
    "@temporalio/activity": "^1.0.0",
    "@temporalio/client": "^1.0.0",
    "@temporalio/worker": "^1.0.0",
    "@temporalio/workflow": "^1.0.0",
    "dotenv": "^16.5.0",
    "nanoid": "3.x",
    "next": "^15.3.1",
    "node-fetch": "^2.6.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@tsconfig/node14": "^1.0.0",
    "@types/node": "^16.11.64",
    "@types/node-fetch": "^2.6.2",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "eslint": "^7.32.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-deprecation": "^1.2.1",
    "rimraf": "^3.0.2",
    "ts-node": "^10.8.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^4.4.2"
  }
}
